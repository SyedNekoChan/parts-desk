{
  "name": "parts-desk",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Listing builder for IT hardware part numbers. Searches with Tavily, writes with Mistral, runs entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "server": "node server/app.js",
    "server:dev": "node --watch server/app.js",
    "test": "node test/logic.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.0"
  }
}
